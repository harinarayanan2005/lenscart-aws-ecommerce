# LensCart Frontend Environment Variables
# Copy to .env.local for local development or configure in build pipeline

# AWS Lambda Function URL or Local FastAPI Backend URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# Amazon Cognito Configuration (Populated after SAM deploy; uses built-in local Cognito-compatible JWT auth when in local dev mode)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_LensCartPool
VITE_COGNITO_CLIENT_ID=lenscart-web-client
VITE_AUTH_MODE=hybrid

