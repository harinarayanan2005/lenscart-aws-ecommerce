# LensCart Backend Configuration
# Copy to .env for local overrides; never commit real secrets

APP_ENV=development
AWS_REGION=us-east-1

# DynamoDB Configuration (Uses embedded Moto/DynamoDB Local in development, or real AWS DynamoDB in production)
USE_LOCAL_AWS=true
DYNAMODB_ENDPOINT_URL=
TABLE_PREFIX=lenscart

# Amazon Cognito User Pool Configuration
COGNITO_USER_POOL_ID=us-east-1_LensCartPool
COGNITO_CLIENT_ID=lenscart-web-client
JWT_SECRET_KEY=lenscart-dev-cognito-compatible-jwt-secret-key-2026

# Amazon S3 Media Bucket (Private bucket with Presigned PUT/GET URLs)
S3_MEDIA_BUCKET=lenscart-product-media-private
S3_FRONTEND_BUCKET=lenscart-frontend-assets
MAX_UPLOAD_SIZE_BYTES=5242880

# Amazon SQS & SNS Configuration
SQS_ORDER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/lenscart-order-queue
SNS_ORDER_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:lenscart-order-events

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

