# LensCart Serverless Backend Configuration Example
# Copy to .env for local development. Never commit real .env or AWS credentials.

APP_NAME=LensCart Serverless API
APP_ENV=development
AWS_REGION=ap-south-1
USE_LOCAL_AWS=true

# Optional explicit DynamoDB table names (defaults to ${TABLE_PREFIX}-<entity> when blank)
TABLE_PREFIX=lenscart
DYNAMODB_PRODUCTS_TABLE=
DYNAMODB_CATEGORIES_TABLE=
DYNAMODB_INVENTORY_TABLE=
DYNAMODB_CARTS_TABLE=
DYNAMODB_WISHLISTS_TABLE=
DYNAMODB_ADDRESSES_TABLE=
DYNAMODB_ORDERS_TABLE=
DYNAMODB_REVIEWS_TABLE=

# Amazon S3 & CloudFront Media Delivery
S3_MEDIA_BUCKET=
S3_FRONTEND_BUCKET=
CLOUDFRONT_MEDIA_DOMAIN=

# Amazon Cognito User Pool (Required when USE_LOCAL_AWS=false)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Amazon SQS & SNS Event-Driven Messaging
SQS_ORDER_QUEUE_URL=
SNS_TOPIC_ARN=

# CORS & Frontend Origin
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
